// Schéma Anime Masters — voir SPEC.md.
// Doit rester compatible SQLite (local) et PostgreSQL (production, étape 6).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Rarity {
  N
  R
  SR
  SSR
  UR
}

enum CardType {
  COMBAT
  MYSTERE
  MAGIE
  COEUR
  AVENTURE
}

enum CharacterRole {
  MAIN
  SUPPORTING
  BACKGROUND
}

enum Finish {
  NORMAL
  HOLO
  GOLD
}

enum PityTrigger {
  NONE
  SSR
  UR
}

/// Un personnage AniList (étape 1).
model Character {
  /// id AniList
  id             Int              @id
  name           String
  nameNative     String?
  /// URL de l'image sur le CDN AniList (on ne stocke pas le fichier)
  imageUrl       String
  descriptionRaw String?
  description    String?
  gender         String?
  age            String?
  birthMonth     Int?
  birthDay       Int?
  favourites     Int
  rarity         Rarity
  type           CardType
  attack         Int
  defense        Int
  /// Puissance : stat à part (popularité), indépendante d'ATK/DEF
  power          Int              @default(0)
  /// Série principale (sert au type et au rôle)
  mainMediaId    Int?
  mainMedia      Media?           @relation("MainMedia", fields: [mainMediaId], references: [id])
  mainRole       CharacterRole
  /// Nombre d'exemplaires tirés (numéros d'exemplaire, étape 2)
  pullCount      Int              @default(0)
  /// Retrait à la demande d'un ayant droit (étape 6)
  disabled       Boolean          @default(false)
  wishedBy       WishlistItem[]
  media          CharacterMedia[]
  cards          Card[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([rarity])
  @@index([type])
  @@index([favourites])
}

/// Une série animée AniList.
model Media {
  id             Int              @id
  titleRomaji    String
  titleEnglish   String?
  titleNative    String?
  format         String?
  year           Int?
  coverUrl       String?
  popularity     Int
  /// Liste des genres AniList (tableau JSON)
  genres         Json
  /// Tags AniList [{ name, rank }] (tableau JSON, sert au type)
  tags           Json?
  studio         String?
  characters     CharacterMedia[]
  mainCharacters Character[]      @relation("MainMedia")
  updatedAt      DateTime         @updatedAt
}

model CharacterMedia {
  characterId Int
  mediaId     Int
  role        CharacterRole
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  media       Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([characterId, mediaId])
  @@index([mediaId])
}

// ---------- Étape 2 : comptes, paquets, cartes ----------

/// Joueur. Les champs d'authentification sont gérés par Better Auth.
model User {
  id                  String            @id
  name                String
  /// Pseudo unique (plugin username de Better Auth, stocké en minuscules)
  username            String            @unique
  email               String            @unique
  emailVerified       Boolean           @default(false)
  image               String?
  /// Cristaux en stock au moment de `crystalsUpdatedAt` (1 cristal = 1 carte ; recharge calculée à la lecture, SPEC étape 4 bis §1)
  crystals            Int               @default(50)
  crystalsUpdatedAt   DateTime          @default(now())
  /// Compteurs de pity, en cartes (SPEC étape 4 bis §4)
  cardsSinceSSR       Int               @default(0)
  cardsSinceUR        Int               @default(0)
  /// Solde en Ryō : toujours égal à la somme de `CurrencyLedger` (étape 3)
  balance             Int               @default(0)
  lastDailyBonusAt    DateTime?
  /// Cristaux achetés pendant la journée `crystalsBoughtDate` (remise à zéro à minuit, heure du serveur)
  crystalsBoughtToday Int               @default(0)
  crystalsBoughtDate  DateTime?
  ledger              CurrencyLedger[]
  tradesSent          Trade[]           @relation("TradeFrom")
  tradesReceived      Trade[]           @relation("TradeTo")
  notifications       Notification[]
  auctionsSold        Auction[]         @relation("AuctionSeller")
  auctionsLeading     Auction[]         @relation("AuctionLeader")
  bids                Bid[]
  wishlist            WishlistItem[]
  achievements        UserAchievement[]
  /// Classement Duel (étape 4)
  elo                 Int               @default(1000)
  /// Duels lancés pendant la journée `duelsStartedDate`
  duelsStartedToday   Int               @default(0)
  duelsStartedDate    DateTime?
  duelsSent           Duel[]            @relation("DuelChallenger")
  duelsReceived       Duel[]            @relation("DuelOpponent")
  duelSlots           DuelSlot[]
  duelDefenses        DuelDefense[]
  sessions            Session[]
  accounts            Account[]
  cards               Card[]
  packOpenings        PackOpening[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Un exemplaire possédé par un joueur.
model Card {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  characterId   Int
  character     Character   @relation(fields: [characterId], references: [id])
  finish        Finish
  /// n-ième exemplaire de ce personnage tiré sur le site
  serial        Int
  /// Rareté au moment du tirage (historique uniquement : la carte affiche la rareté actuelle)
  rarityAtPull  Rarity
  packOpeningId String
  packOpening   PackOpening @relation(fields: [packOpeningId], references: [id], onDelete: Cascade)
  obtainedAt    DateTime    @default(now())
  /// Cadenas : une carte verrouillée ne peut être ni vendue, ni échangée, ni mise aux enchères
  locked        Boolean     @default(false)
  /// Tag « À échanger » : la fiche du personnage liste les joueurs qui le proposent
  forTrade      Boolean     @default(false)
  /// Bloquée pendant une enchère (étape 3, enchères)
  inAuction     Boolean     @default(false)
  tradeItems    TradeItem[]
  auctions      Auction[]

  @@unique([characterId, serial])
  @@index([ownerId, characterId])
}

/// Historique des ouvertures de paquets.
model PackOpening {
  id            String      @id @default(cuid())
  /// Nombre de cartes du lot (5 ou 10)
  lotSize       Int         @default(5)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pityTriggered PityTrigger
  cards         Card[]
  openedAt      DateTime    @default(now())

  @@index([userId, openedAt])
}

// ---------- Étape 3 : économie ----------

enum LedgerReason {
  QUICK_SELL
  DAILY
  PACK_BUY
  CRYSTAL_BUY
  BID_HOLD
  BID_REFUND
  AUCTION_SALE
  AUCTION_FEE
  TRADE_IN
  TRADE_OUT
  DUEL_REWARD
  ACHIEVEMENT
}

/// Journal de tous les mouvements de Ryō (la somme par joueur égale `User.balance`).
model CurrencyLedger {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Positif = gain, négatif = dépense
  amount    Int
  reason    LedgerReason
  /// Objet concerné (carte vendue, enchère, échange…)
  refId     String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
  EXPIRED
  INVALID
}

enum TradeSide {
  FROM
  TO
}

/// Offre d'échange : `from` donne ses cartes + Ryō (côté FROM) contre les cartes + Ryō de `to` (côté TO).
model Trade {
  id           String      @id @default(cuid())
  fromId       String
  from         User        @relation("TradeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  to           User        @relation("TradeTo", fields: [toId], references: [id], onDelete: Cascade)
  fromCurrency Int         @default(0)
  toCurrency   Int         @default(0)
  status       TradeStatus @default(PENDING)
  items        TradeItem[]
  createdAt    DateTime    @default(now())
  expiresAt    DateTime
  resolvedAt   DateTime?

  @@index([fromId, status])
  @@index([toId, status])
}

model TradeItem {
  tradeId String
  trade   Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  cardId  String
  card    Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  side    TradeSide

  @@id([tradeId, cardId])
}

/// Notification dans le site (cloche).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  /// Données propres au type (JSON sérialisé)
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum AuctionStatus {
  ACTIVE
  SOLD
  UNSOLD
  CANCELLED
}

model Auction {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  startPrice      Int
  buyNowPrice     Int?
  currentBid      Int?
  currentBidderId String?
  currentBidder   User?         @relation("AuctionLeader", fields: [currentBidderId], references: [id])
  endsAt          DateTime
  status          AuctionStatus @default(ACTIVE)
  /// Prix final (enchère vendue)
  finalPrice      Int?
  bids            Bid[]
  createdAt       DateTime      @default(now())
  closedAt        DateTime?

  @@index([status, endsAt])
  @@index([sellerId, status])
  @@index([cardId])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

/// Liste de souhaits : un personnage, avec ou sans finition précise (étape 3).
model WishlistItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// null = n'importe quelle finition
  finish      Finish?
  createdAt   DateTime  @default(now())

  @@index([characterId])
  @@index([userId])
}

/// Succès débloqués (étape 4) : une seule fois par joueur et par clé.
model UserAchievement {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@id([userId, key])
}

// ---------- Étape 4 : duels ----------

enum DuelStatus {
  PENDING
  ACCEPTED
  DONE
  DECLINED
  EXPIRED
  FORFEIT
}

/// Duel asynchrone (SPEC étape 4, §1) : équipes choisies à l'avance, quiz joués chacun de son côté, combat calculé par le serveur.
model Duel {
  id                  String         @id @default(cuid())
  challengerId        String
  challenger          User           @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId          String
  opponent            User           @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status              DuelStatus     @default(PENDING)
  createdAt           DateTime       @default(now())
  acceptDeadline      DateTime
  playDeadline        DateTime?
  resolvedAt          DateTime?
  /// null si nul (ou duel sans résultat)
  winnerId            String?
  /// Combat calculé, rejoué tel quel (JSON)
  result              Json?
  eloChangeChallenger Int?
  eloChangeOpponent   Int?
  rewarded            Boolean        @default(false)
  slots               DuelSlot[]
  defenses            DuelDefense[]
  questions           DuelQuestion[]

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([status, acceptDeadline])
  @@index([status, playDeadline])
}

/// Carte d'une équipe, avec instantané des stats au moment du choix (la carte reste libre).
model DuelSlot {
  duelId      String
  duel        Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 à 3 (ordre d'attaque)
  position    Int
  cardId      String
  characterId Int
  type        CardType
  attack      Int
  defense     Int

  @@id([duelId, userId, position])
}

/// Session de défense d'un joueur (quiz sur les 3 cartes adverses).
model DuelDefense {
  duelId     String
  duel       Duel      @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@id([duelId, userId])
}

/// Question du quiz : la bonne réponse ne quitte le serveur qu'après la réponse du joueur.
model DuelQuestion {
  id           String    @id @default(cuid())
  duelId       String
  duel         Duel      @relation(fields: [duelId], references: [id], onDelete: Cascade)
  defenderId   String
  /// Position de la carte adverse (1 à 3)
  slotPosition Int
  /// 0 à 3
  index        Int
  kind         String
  prompt       Json
  choices      Json
  correctIndex Int
  servedAt     DateTime?
  answeredAt   DateTime?
  /// null = pas de réponse à temps (erreur)
  answerIndex  Int?

  @@unique([duelId, defenderId, slotPosition, index])
}
