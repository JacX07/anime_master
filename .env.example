# Copier en .env puis remplir
# Application : pooler transaction Supabase (6543), ou Postgres local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anime_dev"
# Migrations : connexion directe ou pooler session Supabase (5432). Facultatif en local.
# DIRECT_URL="postgresql://..."
# Suite complète : serveur Postgres de test distinct, permission CREATE DATABASE.
# npm run check lit cette valeur depuis l'environnement du terminal, pas depuis .env.
# CHECK_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# Générer avec : node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Code d'invitation à l'inscription. Obligatoire en production (sans lui, les inscriptions sont fermées).
# Mets une phrase longue et aléatoire (12 caractères minimum).
INVITE_CODE=""
